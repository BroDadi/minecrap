<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <Version>0.0.7</Version>
    <AssemblyVersion>0.0.7</AssemblyVersion>
    <FileVersion>0.0.7</FileVersion>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="StbImageSharp" Version="*"/>
    <PackageReference Include="OpenTK" Version="*"/>
    <PackageReference Include="Udun.FastNoiseLite" Version="*"/>
    <PackageReference Include="NativeFileDialogSharp" Version="*"/>
  </ItemGroup>
  <ItemGroup>
    <Content Include="textures\**\*">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="shaders\**\*">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="worlds\**\*">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>
</Project>